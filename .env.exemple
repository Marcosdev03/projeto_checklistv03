SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.azurecontainerapps.io,checklists.tech,www.checklists.tech

# Azure Database for PostgreSQL connection string:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

CORS_ALLOWED_ORIGINS=https://checklists.tech,https://www.checklists.tech
CSRF_TRUSTED_ORIGINS=https://checklists.tech,https://www.checklists.tech
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
